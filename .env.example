# Copy to .env and fill in. talos, talos-server and the desktop app read this file.

# ── talos (each machine) ────────────────────────────────────────────────
# Where talos connects. The first time, talos shows a code to pair with;
# its key is then saved in ~/.talos/credentials.json.
TALOS_SERVER_URL=ws://localhost:7070

# Optional. The name this machine shows up as; defaults to the computer's name.
TALOS_MACHINE_NAME=

# Optional. Your GitHub login. When pairing, talos checks the code was entered
# by this person before taking a key. Without it, talos asks in its terminal
# (and a talos with no terminal won't pair).
TALOS_PAIR_OWNER=

# Optional. Where talos keeps its key, folders and session host; defaults to
# ~/.talos. Set it to run a second talos on this machine, like one for testing.
TALOS_HOME=

# How much talos and talos-server log: quiet (sign-ups, pairings, connections)
# or verbose (every step: page loads, pings, key checks). Defaults to quiet.
TALOS_LOGS_MODE=verbose

# ── talos-server ────────────────────────────────────────────────────────
TALOS_SERVER_PORT=7070

# The address people open the page at. GitHub sends people back to
# <this>/auth/callback after they sign in.
TALOS_PUBLIC_URL=http://localhost:7070

# A GitHub OAuth app: github.com/settings/developers → New OAuth App.
# Homepage URL: http://localhost:7070
# Authorization callback URL: http://localhost:7070/auth/callback
TALOS_GITHUB_CLIENT_ID=
TALOS_GITHUB_CLIENT_SECRET=

# The admin's GitHub account, by its permanent number (not the login, which
# can change hands): api.github.com/users/<login> → "id". The admin can always sign in, and only the
# admin sees the switch that lets new people sign up (off to start with).
TALOS_ADMIN_GITHUB_ID=34290408

# Signs sign-in sessions. Make one with: openssl rand -hex 32
TALOS_SESSION_SECRET=

# Optional. Starts every DynamoDB table name (talos-machines, talos-sign-ins,
# talos-settings).
TALOS_TABLE_PREFIX=talos-

# The local AWS emulator settings live in docker-compose.yml.

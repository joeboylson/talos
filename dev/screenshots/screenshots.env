# Made-up settings for the throwaway screenshots server. Nothing here is a
# real secret: that server lives for one run and holds only made-up data.
TALOS_PUBLIC_URL=http://localhost:7370
TALOS_GITHUB_CLIENT_ID=screenshots
TALOS_GITHUB_CLIENT_SECRET=screenshots
TALOS_ADMIN_GITHUB_LOGIN=joeboylson
TALOS_SESSION_SECRET=screenshots-only
TALOS_LOGS_MODE=quiet

# Copy to .env and fill in. Both talos and talos-server read this file.

# The secret talos shows when it connects. The server turns away anyone without it.
# Make one with: openssl rand -hex 32
TALOS_MACHINE_KEY=

# Where talos-server listens.
TALOS_SERVER_PORT=7070

# Where talos connects.
TALOS_SERVER_URL=ws://localhost:7070

# Optional. The name this machine shows up as; defaults to the computer's name.
TALOS_MACHINE_NAME=
